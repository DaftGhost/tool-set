{
  "name": "random-persona-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "node --experimental-strip-types scripts/dev.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run typecheck && vite build",
    "data:prepare": "node --experimental-strip-types scripts/prepareDataset.ts",
    "data:prepare-subset": "node --experimental-strip-types scripts/prepareSubset.ts",
    "data:import-local": "node --experimental-strip-types scripts/importLocal.ts",
    "data:download": "node --experimental-strip-types scripts/downloadDataset.ts",
    "types:generate": "wrangler types ../../worker/worker-configuration.d.ts --config ../../wrangler.json --include-runtime=false"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "hyparquet": "1.31.5",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "4.152.0"
  }
}

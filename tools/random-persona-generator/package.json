{
  "name": "random-persona-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.7.0",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "dev": "node --experimental-strip-types scripts/dev.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run typecheck && vite build",
    "data:prepare": "node --experimental-strip-types scripts/prepareDataset.ts",
    "data:prepare-subset": "node --experimental-strip-types scripts/prepareSubset.ts",
    "data:import-local": "node --experimental-strip-types scripts/importLocal.ts",
    "data:download": "node --experimental-strip-types scripts/downloadDataset.ts",
    "types:generate": "wrangler types ../../worker/worker-configuration.d.ts --config ../../wrangler.json"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "hyparquet": "1.31.2",
    "jsdom": "^26.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.0",
    "wrangler": "4.144.0"
  }
}
